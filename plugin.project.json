{
  "name": "Rojo",
  "globIgnorePaths": [
    "plugin/Packages/msgpack-luau",
    "plugin/Packages/Roact",
    "plugin/Packages/Roact/src/Binding.lua",
    "plugin/Packages/Roact/src/Component.lua",
    "plugin/Packages/Roact/src/RobloxRenderer.lua",
    "plugin/Packages/Roact/src/createReconciler.lua"
  ],
  "tree": {
    "$className": "Folder",
    "Plugin": {
      "$path": "plugin/src"
    },
    "Packages": {
      "$path": "plugin/Packages",
      "Log": {
        "$path": "plugin/log"
      },
      "Http": {
        "$path": "plugin/http"
      },
      "Fmt": {
        "$path": "plugin/fmt"
      },
      "RbxDom": {
        "$path": "plugin/rbx_dom_lua"
      },
      "msgpack": {
        "$path": "plugin/msgpack.lua"
      },
      "Roact": {
        "$path": "plugin/Packages/Roact/src",
        "Binding": {
          "$path": "plugin/roact-binding.lua"
        },
        "Component": {
          "$path": "plugin/roact-component.lua"
        },
        "RobloxRenderer": {
          "$path": "plugin/roact-renderer.lua"
        },
        "createReconciler": {
          "$path": "plugin/roact-reconciler.lua"
        }
      }
    },
    "Version": {
      "$path": "plugin/Version.txt"
    },
    "UploadDetails": {
      "$path": "plugin/UploadDetails.json"
    }
  }
}
